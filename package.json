{
  "name": "uz-planner",
  "version": "1.0.0",
  "description": "Zamonaviy Uzbek tilidagi desktop planner",
  "main": "main.js",
  "author": "Uz Planner",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.uzplanner.app",
    "productName": "Uz Planner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    }
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
